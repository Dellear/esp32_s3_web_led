CONFIG_IDF_TARGET="esp32s3"

# N16R8 板子：16MB 闪存 + 8MB OPI PSRAM
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 分区表：对应 Arduino 的 app3M_fat9M_16MB
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# HTTP 服务器 + WebSocket
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
# 浏览器的请求头经常超过默认的 512 字节
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# 两个 HTTP 服务器 + 两个 TCP 测速端口 + mDNS，默认 10 个 socket 不够
CONFIG_LWIP_MAX_SOCKETS=24

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# 不需要 mDNS 的命令行调试功能
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n

# ---------- 网速优化（参考 ESP-IDF 官方 examples/wifi/iperf 的 ESP32-S3 配置） ----------
# TCP 窗口：默认只有 5760 字节，往返几毫秒就会卡在 10 Mbps 以下。调到 lwIP 不开窗口缩放时的上限
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
# 收包队列要能装下一整个窗口的包（65535 / 1440 ≈ 46 个）
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
# 把 lwIP 收发的关键函数放进 IRAM，不受闪存缓存未命中影响
CONFIG_LWIP_IRAM_OPTIMIZATION=y

# WiFi 收发缓冲和 A-MPDU 聚合窗口：默认 6 个包一聚合，调到 32
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_BA_WIN=32

# CPU 跑满 240 MHz，编译用性能优化（默认是 -Og 调试优化）
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 窗口调大后，测速时 WiFi 和 lwIP 的缓冲会占掉大量内部 RAM（实测最少只剩 21 KB），
# 让它们优先从 8MB PSRAM 里分配，内部 RAM 留给其他功能
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# IPv6：接收路由器通告，自动配置全局地址（SLAAC）
CONFIG_LWIP_IPV6_AUTOCONFIG=y
